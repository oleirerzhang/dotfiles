#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
user_dir="${HOME}"
backup_dir="$user_dir/.dotfiles-backup-$(date +%Y%m%d-%H%M%S)"
backup_created=false

link_path() {
  local source_file="$1"
  local destination_file="$2"

  mkdir -p "$(dirname "$destination_file")"

  if [[ -L "$destination_file" ]] && [[ "$(readlink "$destination_file")" == "$source_file" ]]; then
    echo "Already linked: $destination_file"
    return
  fi

  if [[ -e "$destination_file" || -L "$destination_file" ]]; then
    mkdir -p "$backup_dir/$(dirname "${destination_file#$user_dir/}")"
    mv "$destination_file" "$backup_dir/${destination_file#$user_dir/}"
    backup_created=true
  fi

  ln -s "$source_file" "$destination_file"
  echo "Linked: $destination_file"
}

link_path "$repo_dir/home/.zshrc" "$user_dir/.zshrc"
link_path "$repo_dir/home/.gitconfig" "$user_dir/.gitconfig"
link_path "$repo_dir/home/.condarc" "$user_dir/.condarc"
link_path "$repo_dir/home/bin/mupdf" "$user_dir/.local/bin/mupdf"
link_path "$repo_dir/home/bin/desk" "$user_dir/.local/bin/desk"
link_path "$repo_dir/home/.config/starship.toml" "$user_dir/.config/starship.toml"
link_path "$repo_dir/home/.config/nvim" "$user_dir/.config/nvim"
link_path "$repo_dir/home/.config/kitty" "$user_dir/.config/kitty"
link_path "$repo_dir/home/.config/yabai" "$user_dir/.config/yabai"
link_path "$repo_dir/home/.config/skhd" "$user_dir/.config/skhd"
link_path "$repo_dir/home/.config/fastfetch" "$user_dir/.config/fastfetch"
link_path "$repo_dir/home/.config/fish" "$user_dir/.config/fish"
link_path "$repo_dir/home/.config/git" "$user_dir/.config/git"
link_path "$repo_dir/home/.config/diffnav" "$user_dir/.config/diffnav"
link_path "$repo_dir/home/.config/thefuck" "$user_dir/.config/thefuck"
link_path "$repo_dir/home/.hammerspoon" "$user_dir/.hammerspoon"
link_path "$repo_dir/home/.bash_profile" "$user_dir/.bash_profile"

# Claude Code skills: link each one so skills installed elsewhere in ~/.claude/skills are left alone.
for skill_dir in "$repo_dir"/home/.claude/skills/*/; do
  skill_name="$(basename "$skill_dir")"
  link_path "${skill_dir%/}" "$user_dir/.claude/skills/$skill_name"
done

# Spicetify rewrites config-xpui.ini with machine-specific paths whenever it
# runs, so it is copied rather than linked and the repo copy is a reference.
if [[ ! -e "$user_dir/.config/spicetify/config-xpui.ini" ]]; then
  mkdir -p "$user_dir/.config/spicetify"
  cp "$repo_dir/home/.config/spicetify/config-xpui.ini" "$user_dir/.config/spicetify/config-xpui.ini"
  echo "Copied: $user_dir/.config/spicetify/config-xpui.ini"
fi

if [[ "$backup_created" == true ]]; then
  echo "Previous files backed up to: $backup_dir"
fi
