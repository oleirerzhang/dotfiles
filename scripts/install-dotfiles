#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
user_dir="${HOME}"
backup_dir="$user_dir/.dotfiles-backup-$(date +%Y%m%d-%H%M%S)"
backup_created=false

link_path() {
  local source_file="$1"
  local destination_file="$2"

  mkdir -p "$(dirname "$destination_file")"

  if [[ -L "$destination_file" ]] && [[ "$(readlink "$destination_file")" == "$source_file" ]]; then
    echo "Already linked: $destination_file"
    return
  fi

  if [[ -e "$destination_file" || -L "$destination_file" ]]; then
    mkdir -p "$backup_dir/$(dirname "${destination_file#$user_dir/}")"
    mv "$destination_file" "$backup_dir/${destination_file#$user_dir/}"
    backup_created=true
  fi

  ln -s "$source_file" "$destination_file"
  echo "Linked: $destination_file"
}

link_path "$repo_dir/home/.zshrc" "$user_dir/.zshrc"
link_path "$repo_dir/home/.gitconfig" "$user_dir/.gitconfig"
link_path "$repo_dir/home/.condarc" "$user_dir/.condarc"
link_path "$repo_dir/home/bin/mupdf" "$user_dir/.local/bin/mupdf"
link_path "$repo_dir/home/.config/starship.toml" "$user_dir/.config/starship.toml"
link_path "$repo_dir/home/.config/nvim" "$user_dir/.config/nvim"
link_path "$repo_dir/home/.config/kitty" "$user_dir/.config/kitty"

if [[ "$backup_created" == true ]]; then
  echo "Previous files backed up to: $backup_dir"
fi
