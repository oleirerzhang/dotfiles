#!/usr/bin/env bash
# Refresh the snapshots this repository keeps of the current Mac.
#
# Writes Brewfile, macos/applications.txt and macos/defaults-snapshot.txt.
# Review the diff before committing: a capture reflects whatever happens to be
# installed today, including things installed by accident.
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
user_dir="${HOME}"

{
  echo "# Applications found in /Applications and ~/Applications"
  echo "# Captured: $(date '+%Y-%m-%d %H:%M:%S %Z')"
  echo
  find /Applications "$user_dir/Applications" -maxdepth 1 -type d -name '*.app' -print 2>/dev/null \
    | sed 's#.*/##; s/\.app$//' \
    | sort -fu
} > "$repo_dir/macos/applications.txt"

if command -v brew >/dev/null 2>&1; then
  brew bundle dump --force --file "$repo_dir/Brewfile.generated"

  # The dump is not reliably complete. A circular dependency in the installed
  # keg tabs can abort its sort part-way, and it cannot see App Store apps
  # unless `mas` is installed. Brewfile.extra carries whatever it misses, and
  # any line the dump already covers is dropped so the two cannot drift into
  # duplicates.
  {
    echo "# Homebrew bundle for a clean macOS install."
    echo "#"
    echo "# Generated by scripts/capture: a fresh \`brew bundle dump\` followed by the"
    echo "# curated entries in Brewfile.extra. Edit Brewfile.extra, not this file."
    echo
    cat "$repo_dir/Brewfile.generated"
    echo
    awk '
      function entry_key(line,   kind, name) {
        if (line !~ /^(tap|brew|cask|mas|vscode) "[^"]+"/) return ""
        kind = line
        sub(/ .*$/, "", kind)
        name = line
        sub(/^[a-z]+ "/, "", name)
        sub(/".*$/, "", name)
        sub(/^.*\//, "", name)
        return kind SUBSEP name
      }
      NR == FNR {
        key = entry_key($0)
        if (key != "") dumped[key] = 1
        next
      }
      {
        key = entry_key($0)
        if (key != "" && key in dumped) next
        print
      }
    ' "$repo_dir/Brewfile.generated" "$repo_dir/Brewfile.extra"
  } > "$repo_dir/Brewfile"
fi

if command -v mas >/dev/null 2>&1; then
  mas list > "$repo_dir/macos/mas-apps.generated.txt"
else
  echo "Note: mas is not installed, so App Store apps come from Brewfile.extra." >&2
fi

"$repo_dir/macos/capture-defaults" > "$repo_dir/macos/defaults-snapshot.txt"

echo "Snapshots refreshed. Review generated files before committing."
