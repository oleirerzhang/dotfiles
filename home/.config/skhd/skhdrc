# Simple Rectangle-style window placement. yabai runs in floating mode, so
# these shortcuts only resize the focused window and never rearrange others.
cmd + alt - left  : "$HOME/.config/yabai/scripts/yabai-command" -m window --grid 1:2:0:0:1:1
cmd + alt - right : "$HOME/.config/yabai/scripts/yabai-command" -m window --grid 1:2:1:0:1:1
cmd + alt - up    : "$HOME/.config/yabai/scripts/yabai-command" -m window --grid 2:1:0:0:1:1
cmd + alt - down  : "$HOME/.config/yabai/scripts/yabai-command" -m window --grid 2:1:0:1:1:1
