# Rectangle replacements. These first seven bindings preserve the current
# Cmd+Option placement keys exactly; snapping floats a tiled window first.
cmd + alt - left  : "$HOME/.config/yabai/scripts/float-window" --grid 1:2:0:0:1:1
cmd + alt - right : "$HOME/.config/yabai/scripts/float-window" --grid 1:2:1:0:1:1
cmd + alt - up    : "$HOME/.config/yabai/scripts/float-window" --grid 2:1:0:0:1:1
cmd + alt - down  : "$HOME/.config/yabai/scripts/float-window" --grid 2:1:0:1:1:1
cmd + alt - f     : "$HOME/.config/yabai/scripts/float-window" --grid 1:1:0:0:1:1
cmd + alt - d     : "$HOME/.config/yabai/scripts/float-window" --grid 20:20:1:1:18:18
cmd + alt - c     : "$HOME/.config/yabai/scripts/float-window" --grid 4:4:1:1:2:2

# Preserve Rectangle's Fill Left/Right actions.
ctrl - left  : "$HOME/.config/yabai/scripts/float-window" --resize left:-10000:0
ctrl - right : "$HOME/.config/yabai/scripts/float-window" --resize right:10000:0

# Rectangle's display, 2x2 tiling, and reveal-desktop shortcuts.
# 0x21 = [, 0x1E = ], and 0x2A = backslash on an ANSI keyboard.
ctrl + alt + cmd - 0x21 : "$HOME/.config/yabai/scripts/yabai-command" -m window --display prev && "$HOME/.config/yabai/scripts/yabai-command" -m display --focus prev
ctrl + alt + cmd - 0x1E : "$HOME/.config/yabai/scripts/yabai-command" -m window --display next && "$HOME/.config/yabai/scripts/yabai-command" -m display --focus next
ctrl + alt + cmd - 2    : "$HOME/.config/yabai/scripts/yabai-command" -m space --layout bsp && "$HOME/.config/yabai/scripts/yabai-command" -m space --balance
ctrl + alt + cmd - 0x2A : "$HOME/.config/yabai/scripts/yabai-command" -m space --toggle show-desktop

# Instant Space focus. These go through yabai instead of Mission Control, so
# there is no slide animation. Shift sends the focused window and follows it.
ctrl - 1 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 1
ctrl - 2 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 2
ctrl - 3 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 3
ctrl - 4 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 4
ctrl - 5 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 5
ctrl - 6 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 6
ctrl - 7 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 7
ctrl - 8 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 8
ctrl - 9 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 9

shift + ctrl - 1 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 1 && "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 1
shift + ctrl - 2 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 2 && "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 2
shift + ctrl - 3 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 3 && "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 3
shift + ctrl - 4 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 4 && "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 4
shift + ctrl - 5 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 5 && "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 5
shift + ctrl - 6 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 6 && "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 6
shift + ctrl - 7 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 7 && "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 7
shift + ctrl - 8 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 8 && "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 8
shift + ctrl - 9 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 9 && "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 9

ctrl + cmd - left  : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus prev
ctrl + cmd - right : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus next
ctrl + cmd - 0     : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus recent

shift + ctrl + cmd - left  : "$HOME/.config/yabai/scripts/yabai-command" -m window --space prev && "$HOME/.config/yabai/scripts/yabai-command" -m space --focus prev
shift + ctrl + cmd - right : "$HOME/.config/yabai/scripts/yabai-command" -m window --space next && "$HOME/.config/yabai/scripts/yabai-command" -m space --focus next

# Keyboard-first tiling controls.
# Rebuild a BSP tree for every eligible window on the current Space.
ctrl + alt - b : "$HOME/.config/yabai/scripts/retile-space"

# Cycle through the managed windows, with wrapping. This also cycles a stack.
ctrl + alt - tab         : "$HOME/.config/yabai/scripts/focus-cycle" next
shift + ctrl + alt - tab : "$HOME/.config/yabai/scripts/focus-cycle" prev

ctrl + alt - h : "$HOME/.config/yabai/scripts/yabai-command" -m window --focus west
ctrl + alt - j : "$HOME/.config/yabai/scripts/yabai-command" -m window --focus south
ctrl + alt - k : "$HOME/.config/yabai/scripts/yabai-command" -m window --focus north
ctrl + alt - l : "$HOME/.config/yabai/scripts/yabai-command" -m window --focus east

shift + ctrl + alt - h : "$HOME/.config/yabai/scripts/yabai-command" -m window --swap west
shift + ctrl + alt - j : "$HOME/.config/yabai/scripts/yabai-command" -m window --swap south
shift + ctrl + alt - k : "$HOME/.config/yabai/scripts/yabai-command" -m window --swap north
shift + ctrl + alt - l : "$HOME/.config/yabai/scripts/yabai-command" -m window --swap east

ctrl + alt - return : "$HOME/.config/yabai/scripts/yabai-command" -m window --toggle zoom-fullscreen
ctrl + alt - space  : "$HOME/.config/yabai/scripts/yabai-command" -m window --toggle float
ctrl + alt - 0      : "$HOME/.config/yabai/scripts/yabai-command" -m space --balance

# Layout controls. Floating the whole Space deliberately disables tiling-tree
# navigation until Control+Option+B rebuilds it.
ctrl + alt - s         : "$HOME/.config/yabai/scripts/yabai-command" -m space --layout stack
ctrl + alt - f         : "$HOME/.config/yabai/scripts/yabai-command" -m window --toggle float
shift + ctrl + alt - f : "$HOME/.config/yabai/scripts/yabai-command" -m space --layout float
