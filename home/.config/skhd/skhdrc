# Simple Rectangle-style window placement. yabai runs in floating mode, so
# these shortcuts only resize the focused window and never rearrange others.
cmd + alt - left  : "$HOME/.config/yabai/scripts/yabai-command" -m window --grid 1:2:0:0:1:1
cmd + alt - right : "$HOME/.config/yabai/scripts/yabai-command" -m window --grid 1:2:1:0:1:1
cmd + alt - up    : "$HOME/.config/yabai/scripts/yabai-command" -m window --grid 2:1:0:0:1:1
cmd + alt - down  : "$HOME/.config/yabai/scripts/yabai-command" -m window --grid 2:1:0:1:1:1
cmd + alt - f     : "$HOME/.config/yabai/scripts/yabai-command" -m window --grid 1:1:0:0:1:1

# Constraint-aware quadrants. H/J are the left column; K/L are the right.
cmd + alt - h : "$HOME/.config/yabai/scripts/quadrant-window" top-left
cmd + alt - j : "$HOME/.config/yabai/scripts/quadrant-window" bottom-left
cmd + alt - k : "$HOME/.config/yabai/scripts/quadrant-window" top-right
cmd + alt - l : "$HOME/.config/yabai/scripts/quadrant-window" bottom-right

# Workspace switching. yabai focuses the space directly instead of going
# through Mission Control, so there is no slide animation.
cmd + alt - 1 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 1
cmd + alt - 2 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 2
cmd + alt - 3 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 3
cmd + alt - 4 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 4
cmd + alt - 5 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 5
cmd + alt - 6 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 6
cmd + alt - 7 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 7
cmd + alt - 8 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 8
cmd + alt - 9 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus 9

# Previous / next space ([ and ]), and the last space you came from (tab).
cmd + alt - 0x21 : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus prev
cmd + alt - 0x1E : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus next
cmd + alt - tab  : "$HOME/.config/yabai/scripts/yabai-command" -m space --focus recent

# Send the focused window to a space (shift), staying where you are.
cmd + alt + shift - 1 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 1
cmd + alt + shift - 2 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 2
cmd + alt + shift - 3 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 3
cmd + alt + shift - 4 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 4
cmd + alt + shift - 5 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 5
cmd + alt + shift - 6 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 6
cmd + alt + shift - 7 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 7
cmd + alt + shift - 8 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 8
cmd + alt + shift - 9 : "$HOME/.config/yabai/scripts/yabai-command" -m window --space 9

# Whole-Space layouts. Same modifiers as the single-window shortcuts above,
# plus shift: without shift you place the focused window, with shift you
# arrange every window on the Space. Pressing one twice rotates which window
# gets the main slot.
cmd + alt + shift - left  : "$HOME/.config/yabai/scripts/layout-space" main-left
cmd + alt + shift - right : "$HOME/.config/yabai/scripts/layout-space" main-right
cmd + alt + shift - h : "$HOME/.config/yabai/scripts/layout-space" halves
cmd + alt + shift - q : "$HOME/.config/yabai/scripts/layout-space" quadrants
cmd + alt + shift - e : "$HOME/.config/yabai/scripts/layout-space" eighths
cmd + alt + shift - c : "$HOME/.config/yabai/scripts/layout-space" columns
cmd + alt + shift - r : "$HOME/.config/yabai/scripts/layout-space" rows

# Workspace management:
# Create a workspace immediately to the right and focus it
cmd + alt - n : "$HOME/.config/yabai/scripts/insert-space"

# Move current window to next workspace and follow it
shift + alt - n : yabai -m window --space next --focus

# Move to previous workspace
shift + alt - p : yabai -m window --space prev --focus

# Focus a specific window on the current Space by visual reading order:
# top to bottom, and left to right within each row. A number with no window is
# a no-op. cmd + ctrl keeps this as quick as the cmd + alt Space shortcuts.
cmd + ctrl - 1 : "$HOME/.config/yabai/scripts/focus-window" position 1
cmd + ctrl - 2 : "$HOME/.config/yabai/scripts/focus-window" position 2
cmd + ctrl - 3 : "$HOME/.config/yabai/scripts/focus-window" position 3
cmd + ctrl - 4 : "$HOME/.config/yabai/scripts/focus-window" position 4
cmd + ctrl - 5 : "$HOME/.config/yabai/scripts/focus-window" position 5
cmd + ctrl - 6 : "$HOME/.config/yabai/scripts/focus-window" position 6
cmd + ctrl - 7 : "$HOME/.config/yabai/scripts/focus-window" position 7
cmd + ctrl - 8 : "$HOME/.config/yabai/scripts/focus-window" position 8
cmd + ctrl - 9 : "$HOME/.config/yabai/scripts/focus-window" position 9
