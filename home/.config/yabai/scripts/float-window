#!/bin/sh
set -eu

if [ -x /opt/homebrew/bin/yabai ]; then
  yabai_bin=/opt/homebrew/bin/yabai
elif [ -x /usr/local/bin/yabai ]; then
  yabai_bin=/usr/local/bin/yabai
else
  echo "yabai: executable not found" >&2
  exit 1
fi

window_json=$("$yabai_bin" -m query --windows --window)
is_floating=$(printf '%s\n' "$window_json" | \
  /usr/bin/plutil -extract is-floating raw -o - -)

if [ "$is_floating" != "true" ]; then
  "$yabai_bin" -m window --toggle float
fi

exec "$yabai_bin" -m window "$@"
