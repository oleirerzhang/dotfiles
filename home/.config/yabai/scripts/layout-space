#!/bin/sh
# Arrange the windows on the current Space into a named layout.
#
#   layout-space halves|quadrants|eighths|main-left|main-right|columns|rows
#
# Windows fill the layout's slots in yabai's own front-to-back order, so the
# window you used most recently takes the first slot. When a layout has fewer
# slots than the Space has windows, the windows further back are left exactly
# where they are.
#
# Applying the same layout again rotates the windows through the slots, so a
# repeated press cycles which one gets the main slot. Only windows that were
# already placed take part in the rotation. Set YABAI_LAYOUT_ROTATE=0 to make
# the shortcuts idempotent instead.
#
# Sizes are negotiated rather than imposed: every window is asked for its
# share, then measured, because an application may refuse to shrink below its
# own minimum. Whatever it refuses to give up is taken off its neighbours.
# When the minimums cannot fit side by side at all, the windows are left at
# those minimums and allowed to overlap.
set -eu

layout=${1:-}
case "$layout" in
  halves|quadrants|eighths|main-left|main-right|columns|rows) ;;
  *)
    echo "usage: layout-space halves|quadrants|eighths|main-left|main-right|columns|rows" >&2
    exit 2
    ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
yabai_command="$script_dir/yabai-command"
visible_frame="$script_dir/visible-frame"

space_json=$("$yabai_command" -m query --spaces --space)
space_index=$(printf '%s\n' "$space_json" | /usr/bin/jq -r '.index')
display_index=$(printf '%s\n' "$space_json" | /usr/bin/jq -r '.display')

if printf '%s\n' "$space_json" | /usr/bin/jq -e '."is-native-fullscreen"' >/dev/null; then
  exit 0
fi

# Only real, resizable, on-screen windows take part. Panels, sheets and
# palettes report a subrole other than AXStandardWindow.
windows=$("$yabai_command" -m query --windows --space | /usr/bin/jq -r \
  --argjson display "$display_index" '
  .[]
  | select(
      .display == $display
      and ."can-move" == true and ."can-resize" == true
      and ."is-visible" == true and ."is-minimized" == false
      and ."is-sticky" == false and ."is-native-fullscreen" == false
      and .subrole == "AXStandardWindow"
    )
  | .id')

window_count=$(printf '%s' "$windows" | /usr/bin/grep -c . || true)
[ "$window_count" -gt 0 ] || exit 0

work_dir=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/yabai-layout.XXXXXX")
trap '/bin/rm -rf "$work_dir"' EXIT HUP INT TERM

# Each layout emits one slot per line, in the order slots are filled:
#   column row column-weight row-weight
# Only the ratios between weights matter.
slots_of_layout() {
  slot_count=$1
  case "$layout" in
    halves)
      [ "$slot_count" -gt 2 ] && slot_count=2
      /usr/bin/awk -v n="$slot_count" 'BEGIN {
        for (i = 0; i < n; i++) print i, 0, 500, 1000
      }'
      ;;
    quadrants)
      [ "$slot_count" -gt 4 ] && slot_count=4
      /usr/bin/awk -v n="$slot_count" 'BEGIN {
        split("0 0,0 1,1 0,1 1", order, ",")
        for (i = 1; i <= n; i++) {
          split(order[i], cell, " ")
          print cell[1], cell[2], 500, 500
        }
      }'
      ;;
    eighths)
      [ "$slot_count" -gt 8 ] && slot_count=8
      /usr/bin/awk -v n="$slot_count" 'BEGIN {
        for (i = 0; i < n; i++) print int(i / 2), i % 2, 250, 500
      }'
      ;;
    main-left|main-right)
      [ "$slot_count" -gt 4 ] && slot_count=4
      if [ "$layout" = main-left ]; then
        main_column=0 stack_column=1
      else
        main_column=1 stack_column=0
      fi
      /usr/bin/awk -v n="$slot_count" -v main="$main_column" -v stack="$stack_column" 'BEGIN {
        if (n == 1) { print main, 0, 1000, 1000; exit }
        print main, 0, 600, 1000
        for (i = 0; i < n - 1; i++) print stack, i, 400, 1000
      }'
      ;;
    columns)
      [ "$slot_count" -gt 4 ] && slot_count=4
      /usr/bin/awk -v n="$slot_count" 'BEGIN {
        for (i = 0; i < n; i++) print i, 0, 1000, 1000
      }'
      ;;
    rows)
      [ "$slot_count" -gt 4 ] && slot_count=4
      /usr/bin/awk -v n="$slot_count" 'BEGIN {
        for (i = 0; i < n; i++) print 0, i, 1000, 1000
      }'
      ;;
  esac
}

slots_of_layout "$window_count" > "$work_dir/slots"
slot_count=$(/usr/bin/wc -l < "$work_dir/slots" | /usr/bin/tr -d ' ')
[ "$slot_count" -gt 0 ] || exit 0

# Remembered only so a repeated press can rotate the assignment. Scoped to the
# display and Space, and discarded automatically at boot.
state_root="${TMPDIR:-/tmp}/yabai-layouts-$(id -u)"
/bin/mkdir -p "$state_root"
/bin/chmod 700 "$state_root"
state_file="$state_root/display-${display_index}-space-${space_index}"

window_key=$(printf '%s\n' "$windows" | /usr/bin/tr '\n' ',')
offset=0
if [ "${YABAI_LAYOUT_ROTATE:-1}" != 0 ] && [ -r "$state_file" ]; then
  IFS=' ' read -r previous_layout previous_offset previous_key < "$state_file" || true
  if [ "${previous_layout:-}" = "$layout" ] && [ "${previous_key:-}" = "$window_key" ]; then
    case "${previous_offset:-}" in
      ''|*[!0-9]*) offset=0 ;;
      *) offset=$(((previous_offset + 1) % slot_count)) ;;
    esac
  fi
fi

# Rotation permutes the windows that already hold slots. Windows past the last
# slot stay out of the layout entirely rather than cycling into view.
printf '%s\n' "$windows" | /usr/bin/head -n "$slot_count" |
  /usr/bin/awk -v offset="$offset" '
    { id[NR] = $1; n = NR }
    END { for (i = 0; i < n; i++) print id[(i + offset) % n + 1] }' > "$work_dir/ids"

/usr/bin/paste -d' ' "$work_dir/slots" "$work_dir/ids" > "$work_dir/placements"

set -- $("$visible_frame" "$display_index")
screen_x=$1 screen_y=$2 screen_w=$3 screen_h=$4

# Distribute `total` across items given a nominal weight and a hard minimum
# for each. Reads "weight minimum" lines, writes one size per line.
solve_axis() {
  /usr/bin/awk -v total="$1" '
    { weight[NR] = $1 + 0; minimum[NR] = $2 + 0; n = NR }
    END {
      if (n == 0) exit
      floor_sum = 0
      for (i = 1; i <= n; i++) floor_sum += minimum[i]
      if (floor_sum > total) {
        # No arrangement fits. Ask for the minimums and accept the overlap.
        for (i = 1; i <= n; i++) print (minimum[i] > 0 ? minimum[i] : 1)
        exit
      }

      weight_sum = 0
      for (i = 1; i <= n; i++) weight_sum += weight[i]
      used = 0
      for (i = 1; i < n; i++) {
        size[i] = int(weight[i] / weight_sum * total)
        used += size[i]
      }
      size[n] = total - used

      # A window that refused to shrink keeps its minimum; the shortfall comes
      # out of the windows that still have room to give.
      for (pass = 0; pass < 8; pass++) {
        shortfall = 0
        for (i = 1; i <= n; i++) {
          if (size[i] < minimum[i]) {
            shortfall += minimum[i] - size[i]
            size[i] = minimum[i]
            pinned[i] = 1
          }
        }
        if (shortfall <= 0) break
        slack = 0
        for (i = 1; i <= n; i++) if (!pinned[i]) slack += size[i] - minimum[i]
        if (slack <= 0) break
        for (i = 1; i <= n && shortfall > 0; i++) {
          if (pinned[i]) continue
          give = int((size[i] - minimum[i]) / slack * shortfall)
          if (give > shortfall) give = shortfall
          size[i] -= give
          shortfall -= give
        }
        for (i = 1; i <= n && shortfall > 0; i++) {
          if (pinned[i]) continue
          give = size[i] - minimum[i]
          if (give > shortfall) give = shortfall
          size[i] -= give
          shortfall -= give
        }
      }
      for (i = 1; i <= n; i++) print (size[i] > 0 ? size[i] : 1)
    }'
}

measure_window() {
  /usr/bin/jq -r '"\(.frame.w | floor) \(.frame.h | floor)"' 2>/dev/null
}

# The size each slot would get if every window cooperated.
/usr/bin/awk -v screen_w="$screen_w" -v screen_h="$screen_h" '
  {
    column[NR] = $1; column_weight[NR] = $3; row_weight[NR] = $4
    window_id[NR] = $5; n = NR
    if (!($1 in seen_column)) { seen_column[$1] = 1; column_total += $3 }
    row_total[$1] += $4
  }
  END {
    for (i = 1; i <= n; i++) {
      nominal_w = int(screen_w * column_weight[i] / column_total)
      nominal_h = int(screen_h * row_weight[i] / row_total[column[i]])
      if (nominal_w < 1) nominal_w = 1
      if (nominal_h < 1) nominal_h = 1
      print window_id[i], nominal_w, nominal_h
    }
  }' "$work_dir/placements" > "$work_dir/nominal"

# First pass: ask each window for its nominal size. A window that comes back
# larger than it was asked for has hit its own minimum, and that measurement
# is the only thing worth remembering. Anything that complied has no minimum
# worth working around.
: > "$work_dir/measured"
paste_line=0
while read -r column row column_weight row_weight window_id; do
  paste_line=$((paste_line + 1))
  nominal=$(/usr/bin/sed -n "${paste_line}p" "$work_dir/nominal")
  nominal_w=$(printf '%s\n' "$nominal" | /usr/bin/awk '{ print $2 }')
  nominal_h=$(printf '%s\n' "$nominal" | /usr/bin/awk '{ print $3 }')

  # A window can only grow into the room below and to the right of where it
  # currently sits, so park it against the top left corner first. Otherwise
  # the clamped result reads as a minimum the application never asked for.
  current=$("$yabai_command" -m query --windows --window "$window_id" 2>/dev/null |
    /usr/bin/jq -r '"\(.frame.x | floor) \(.frame.y | floor)"') || current=
  if [ -n "$current" ]; then
    current_x=${current% *}
    current_y=${current#* }
    if [ $((current_x + nominal_w)) -gt $((screen_x + screen_w)) ] ||
       [ $((current_y + nominal_h)) -gt $((screen_y + screen_h)) ]; then
      "$yabai_command" -m window "$window_id" \
        --move "abs:${screen_x}:${screen_y}" >/dev/null 2>&1 || true
    fi
  fi

  "$yabai_command" -m window "$window_id" \
    --resize "abs:${nominal_w}:${nominal_h}" >/dev/null 2>&1 || true
  measured=$("$yabai_command" -m query --windows --window "$window_id" 2>/dev/null |
    measure_window) || measured=
  [ -n "$measured" ] || measured="$nominal_w $nominal_h"
  actual_w=${measured% *}
  actual_h=${measured#* }

  minimum_w=0
  minimum_h=0
  [ "$actual_w" -gt "$nominal_w" ] && minimum_w=$actual_w
  [ "$actual_h" -gt "$nominal_h" ] && minimum_h=$actual_h

  printf '%s %s %s %s %s %s %s\n' \
    "$column" "$row" "$column_weight" "$row_weight" "$window_id" \
    "$minimum_w" "$minimum_h" >> "$work_dir/measured"
done < "$work_dir/placements"

column_list=$(/usr/bin/awk '{ print $1 }' "$work_dir/placements" | /usr/bin/sort -n -u)
column_count=$(printf '%s\n' "$column_list" | /usr/bin/grep -c . || true)

# A column can be no narrower than the widest window it has to hold.
for column in $column_list; do
  /usr/bin/awk -v c="$column" '$1 == c { if ($6 > widest) widest = $6; weight = $3 }
    END { print weight, widest + 0 }' "$work_dir/measured"
done > "$work_dir/column_input"
solve_axis "$screen_w" < "$work_dir/column_input" > "$work_dir/column_sizes"

column_offset=$screen_x
column_position=0
for column in $column_list; do
  column_position=$((column_position + 1))
  column_w=$(/usr/bin/sed -n "${column_position}p" "$work_dir/column_sizes")

  # Top to bottom, so the offsets accumulate in the order they are drawn.
  /usr/bin/awk -v c="$column" '$1 == c { print $2, $4, $7, $5 }' "$work_dir/measured" |
    /usr/bin/sort -n -k1,1 > "$work_dir/column_rows"
  /usr/bin/awk '{ print $2, $3 }' "$work_dir/column_rows" > "$work_dir/row_input"
  solve_axis "$screen_h" < "$work_dir/row_input" > "$work_dir/row_sizes"
  row_count=$(/usr/bin/wc -l < "$work_dir/row_sizes" | /usr/bin/tr -d ' ')

  row_offset=$screen_y
  row_position=0
  /usr/bin/awk '{ print $4 }' "$work_dir/column_rows" |
  while read -r window_id; do
    row_position=$((row_position + 1))
    row_h=$(/usr/bin/sed -n "${row_position}p" "$work_dir/row_sizes")

    # The last column and the last row anchor to the far edge, so a window
    # that overflowed spills back over its neighbour rather than off-screen.
    anchor_position() {
      anchor_size=$1 anchor_origin=$2 anchor_extent=$3 anchor_far=$4
      if [ "$anchor_far" = far ]; then
        anchor_result=$((anchor_origin + anchor_extent - anchor_size))
        [ "$anchor_result" -ge "$anchor_origin" ] || anchor_result=$anchor_origin
      else
        anchor_result=$anchor_size
      fi
      printf '%s\n' "$anchor_result"
    }

    column_edge=near
    [ "$column_position" -eq "$column_count" ] && column_edge=far
    row_edge=near
    [ "$row_position" -eq "$row_count" ] && row_edge=far

    target_x=$(anchor_position "$column_offset" "$screen_x" "$screen_w" near)
    [ "$column_edge" = far ] &&
      target_x=$(anchor_position "$column_w" "$screen_x" "$screen_w" far)
    target_y=$(anchor_position "$row_offset" "$screen_y" "$screen_h" near)
    [ "$row_edge" = far ] &&
      target_y=$(anchor_position "$row_h" "$screen_y" "$screen_h" far)

    # Position first: a window cannot be resized into space that lies off the
    # screen from where it currently sits.
    "$yabai_command" -m window "$window_id" \
      --move "abs:${target_x}:${target_y}" >/dev/null 2>&1 || true
    "$yabai_command" -m window "$window_id" \
      --resize "abs:${column_w}:${row_h}" >/dev/null 2>&1 || true

    measured=$("$yabai_command" -m query --windows --window "$window_id" 2>/dev/null |
      measure_window) || measured=
    [ -n "$measured" ] || measured="$column_w $row_h"
    actual_w=${measured% *}
    actual_h=${measured#* }

    # Re-anchor only if the window came back a different size than asked for.
    if [ "$actual_w" != "$column_w" ] || [ "$actual_h" != "$row_h" ]; then
      [ "$column_edge" = far ] &&
        target_x=$(anchor_position "$actual_w" "$screen_x" "$screen_w" far)
      [ "$row_edge" = far ] &&
        target_y=$(anchor_position "$actual_h" "$screen_y" "$screen_h" far)
      "$yabai_command" -m window "$window_id" \
        --move "abs:${target_x}:${target_y}" >/dev/null 2>&1 || true
    fi

    row_offset=$((row_offset + row_h))
  done

  column_offset=$((column_offset + column_w))
done

printf '%s %s %s\n' "$layout" "$offset" "$window_key" > "$state_file"
