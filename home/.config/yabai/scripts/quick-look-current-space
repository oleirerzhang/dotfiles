#!/bin/sh
set -u

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
yabai_command="$script_dir/yabai-command"

if [ -x /opt/homebrew/bin/skhd ]; then
  skhd_bin=/opt/homebrew/bin/skhd
elif [ -x /usr/local/bin/skhd ]; then
  skhd_bin=/usr/local/bin/skhd
else
  echo "skhd: executable not found" >&2
  exit 1
fi

if [ "${1:-}" = "--pass-through" ]; then
  exec "$skhd_bin" -k "space"
fi

origin_space=$("$yabai_command" -m query --spaces --space 2>/dev/null | \
  /usr/bin/jq -r '.index // empty' 2>/dev/null)

# Never swallow Finder's native Spacebar if yabai is temporarily unavailable.
if [ -z "$origin_space" ]; then
  exec "$skhd_bin" -k "shift + ctrl + alt + cmd - f20"
fi

# A new Quick Look panel should be born on the Space where Spacebar was
# pressed. Reused panels are handled by the correction loop below.
"$yabai_command" -m rule --remove quick-look-here 2>/dev/null || true
"$yabai_command" -m rule --add --one-shot label=quick-look-here \
  app="^Finder$" title="^Quick Look$" manage=off space="$origin_space"

# Enter skhd's one-key pass-through mode. It sends the native Spacebar event
# to Finder without recursively invoking this script.
"$skhd_bin" -k "shift + ctrl + alt + cmd - f20"

# Finder sometimes reuses a panel whose home Space predates this keypress.
# Once that panel becomes visible, move it when possible and restore focus to
# the originating Space. Keep watching briefly because macOS can schedule its
# Space jump after the panel itself has already appeared.
attempt=0
moved_quick_look_id=
while [ "$attempt" -lt 160 ]; do
  quick_look_id=$("$yabai_command" -m query --windows | \
    /usr/bin/jq -r '
      .[]
      | select(.app == "Finder" and .title == "Quick Look")
      | select(."is-visible" == true or ."has-focus" == true)
      | .id
    ' | /usr/bin/head -n 1)

  if [ -n "$quick_look_id" ]; then
    if [ "$quick_look_id" != "$moved_quick_look_id" ]; then
      "$yabai_command" -m window "$quick_look_id" \
        --space "$origin_space" 2>/dev/null || true
      moved_quick_look_id=$quick_look_id
    fi

    active_space=$("$yabai_command" -m query --spaces --space | \
      /usr/bin/jq -r '.index')
    if [ "$active_space" != "$origin_space" ]; then
      "$yabai_command" -m space --focus "$origin_space" || true
    fi
  fi

  attempt=$((attempt + 1))
  /bin/sleep 0.025
done
