#!/bin/sh
set -eu

if [ -x /opt/homebrew/bin/yabai ]; then
  yabai_bin=/opt/homebrew/bin/yabai
elif [ -x /usr/local/bin/yabai ]; then
  yabai_bin=/usr/local/bin/yabai
else
  echo "yabai: executable not found" >&2
  exit 1
fi

# Use yabai only for explicit window placement. It does not tile new windows,
# manage Quick Look, or rearrange anything automatically.
"$yabai_bin" -m config \
  layout                    float \
  window_animation_duration 0.0

# Clear any BSP layouts left over from an older version of this configuration.
"$yabai_bin" -m query --spaces | /usr/bin/jq -r '.[].index' | while IFS= read -r space_index; do
  "$yabai_bin" -m space "$space_index" --layout float
done

# Restore Desk event hooks after a yabai restart, if the overlay is running.
if [ -x "$HOME/.local/bin/desk" ]; then
  "$HOME/.local/bin/desk" overlay hooks >/dev/null 2>&1 || true
fi
