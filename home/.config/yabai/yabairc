#!/bin/sh

if [ -x /opt/homebrew/bin/yabai ]; then
  yabai_bin=/opt/homebrew/bin/yabai
elif [ -x /usr/local/bin/yabai ]; then
  yabai_bin=/usr/local/bin/yabai
else
  echo "yabai: executable not found" >&2
  exit 1
fi

# SIP stays enabled. Current yabai releases can focus Spaces without the
# scripting addition; this option removes the remaining focus animation.
"$yabai_bin" -m config                             \
  mouse_follows_focus          off                 \
  focus_follows_mouse          off                 \
  window_origin_display        cursor              \
  window_placement             second_child        \
  window_insertion_point       focused             \
  window_zoom_persist          on                  \
  skip_window_focus_animation  on                  \
  window_animation_duration    0.0                 \
  split_ratio                  0.50                \
  split_type                   auto                \
  auto_balance                 off                 \
  top_padding                  8                   \
  bottom_padding               8                   \
  left_padding                 8                   \
  right_padding                8                   \
  window_gap                   8                   \
  layout                       bsp                 \
  mouse_modifier               ctrl                \
  mouse_action1                move                \
  mouse_action2                resize              \
  mouse_drop_action            swap

# Small utility windows and sheets are easier to use floating.
"$yabai_bin" -m rule --add label=system-utilities \
  app="^(System Settings|System Preferences|Calculator)$" manage=off
"$yabai_bin" -m rule --add label=dialogs subrole="^AXDialog$" manage=off
