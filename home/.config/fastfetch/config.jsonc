{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "/Users/oliverzhang/.config/fastfetch/assets/cat_ascii.txt",
    "type": "file",
    "padding": {
      "left": 3,
      "right": 5
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "blue"
    },
    "key": {
      "type": "string"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "uptime",
    "shell",
    "terminal",
    "terminalfont",
    "cpu",
    {
      "type": "memory",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "Storage",
      "folders": "/",
      "showExternal": false,
      "showReadOnly": false,
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "packages",
      "format": "{all} total ({brew} brew, {brew-cask} casks)"
    },
    {
      "type": "wifi",
      "format": "{ssid} ({signal-quality})"
    },
    {
      "type": "localip",
      "format": "{ipv4}"
    },
    {
      "type": "battery",
      "format": "{capacity} - {status} - {cycle-count} cycles"
    }
  ]
}
